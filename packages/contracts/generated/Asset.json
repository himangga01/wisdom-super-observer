{
  "$defs": {
    "Checksum": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "SHA256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "title": "Checksum",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "byte_size": {
      "maximum": 20971520,
      "minimum": 1,
      "title": "Byte Size",
      "type": "integer"
    },
    "checksum": {
      "$ref": "#/$defs/Checksum"
    },
    "content_type": {
      "enum": [
        "image/jpeg",
        "image/png"
      ],
      "title": "Content Type",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "parent_asset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Asset Id"
    },
    "purpose": {
      "enum": [
        "IMPORT_PHOTO",
        "IMPORT_CROP",
        "EVIDENCE"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "state": {
      "enum": [
        "PENDING",
        "READY",
        "DELETING",
        "DELETED",
        "REJECTED"
      ],
      "title": "State",
      "type": "string"
    },
    "store_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Store Id"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "tenant_id",
    "store_id",
    "purpose",
    "parent_asset_id",
    "state",
    "checksum",
    "byte_size",
    "content_type",
    "expires_at",
    "created_at"
  ],
  "title": "Asset",
  "type": "object"
}
