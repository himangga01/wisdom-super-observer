          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount_minor"
      ],
      "title": "Money",
      "type": "object"
    },
    "VariantOption": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
