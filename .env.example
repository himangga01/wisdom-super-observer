# Copy to .env for local development; provide real values through a secret store.
# These names are the planned service boundary, not enabled integrations.
DATABASE_URL=postgresql+psycopg://wso:change-me-test-only@127.0.0.1:54320/wso
# T02 uses separate migration, application and identity database roles.
WSO_MIGRATION_DATABASE_URL=
WSO_APP_DATABASE_URL=
WSO_IDENTITY_DATABASE_URL=
WSO_SESSION_DATABASE_URL=
WSO_WORKER_DATABASE_URL=
# Only for the optional PostgreSQL RLS integration suite; leave blank until role credentials exist.
WSO_TEST_ADMIN_DATABASE_URL=
WSO_TEST_APP_DATABASE_URL=
WSO_TEST_IDENTITY_DATABASE_URL=
WSO_TEST_MIGRATOR_DATABASE_URL=
WSO_TEST_SESSION_DATABASE_URL=
WSO_TEST_WORKER_DATABASE_URL=
WSO_DISPATCH_DATABASE_URL=
WSO_JOB_DATABASE_URL=
WSO_TEST_DISPATCH_DATABASE_URL=
WSO_TEST_JOB_DATABASE_URL=
WSO_TEST_ASSET_MAINTENANCE_DATABASE_URL=
# Explicit real Valkey Redis-transport endpoint; worker/dispatcher have no fallback.
WSO_BROKER_URL=
BROKER_URL=redis://127.0.0.1:56379/0
OIDC_ISSUER=
OIDC_WEB_CLIENT_ID=
OIDC_MOBILE_CLIENT_ID=
# T03 web authentication requires HTTPS issuer/JWKS/public origin and separate roles.
WSO_OIDC_ISSUER=
WSO_OIDC_CLIENT_ID=
WSO_OIDC_CLIENT_SECRET=
WSO_OIDC_JWKS_URL=
WSO_PUBLIC_ORIGIN=
# Same server-only random value on Next and API; minimum 32 characters, never NEXT_PUBLIC.
WSO_AUTH_EXCHANGE_KEY=
# Next flow-cookie encryption key: independent random 32-byte base64url value.
WSO_FLOW_ENCRYPTION_KEY=
SECRET_KEY_PROVIDER=
# T04 local development only: ignored raw 32-byte key file, never store keys in SQL.
# Production injects a secret-manager/KMS provider; local file is not production proof.
WSO_CONNECTION_KEY_FILE=
# Private assets: server-only configuration; incomplete settings disable asset routes.
# Installation UUID and bucket must match the migrator-installed SQL metadata.
# Use a dedicated private bucket and separate API/maintenance IAM credentials.
WSO_ASSET_INSTALLATION_ID=
WSO_ASSET_S3_ENDPOINT_URL=
WSO_ASSET_S3_REGION=
WSO_ASSET_S3_BUCKET=
WSO_ASSET_S3_ACCESS_KEY_ID=
WSO_ASSET_S3_SECRET_ACCESS_KEY=
WSO_ASSET_S3_SESSION_TOKEN=
WSO_ASSET_ACTIVE_KEY_ID=
# JSON object mapping key IDs to absolute protected 32-byte key-file paths.
# Retain old keys for existing envelopes; never expose this setting through NEXT_PUBLIC.
WSO_ASSET_KEY_FILES_JSON=
# Trusted numeric DB address is required when the role URLs use DNS hostnames.
# Bounded asset connections reject every ambient PG-prefixed process variable.
WSO_ASSET_DB_HOSTADDR=
WSO_ASSET_MAINTENANCE_DATABASE_URL=
WSO_ASSET_MAINTENANCE_WORKER_ID=
WSO_ASSET_MAINTENANCE_S3_ACCESS_KEY_ID=
WSO_ASSET_MAINTENANCE_S3_SECRET_ACCESS_KEY=
WSO_ASSET_MAINTENANCE_S3_SESSION_TOKEN=
# 1 is accepted only by the guarded disposable Linux CI fixture.
WSO_ASSET_S3_ALLOW_LOOPBACK_HTTP=0
S3_ENDPOINT=http://127.0.0.1:58333
S3_BUCKET=wso-local-test
S3_REGION=us-east-1
PUBLIC_WEB_ORIGIN=http://127.0.0.1:3000
API_INTERNAL_ORIGIN=http://127.0.0.1:8000
CLI_PROVIDER=
CLI_MODEL=
CLI_TIMEOUT_SECONDS=120
EVIDENCE_RETENTION_DAYS=30
IMPORT_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=365
# Only the local Compose test profile reads this value.
WSO_TEST_DB_PASSWORD=change-me-test-only

# W05 account worker: server-only trusted region/brand endpoint profile file.
# The API receives an injected AccountWorker RPC client; it never receives the
# connection-worker database URL or a saved-secret decrypt service. Reuse the
# existing T04 worker role/key configuration in the separate worker process.
# WSO_TVT_ACCOUNT_PROFILE_FILE=
# Missing trusted profile/RPC configuration leaves account requests unavailable.

# W05 API account RPC client (base bridge dependency; all four required).
WSO_TVT_BRIDGE_ENDPOINT=
WSO_TVT_BRIDGE_CA_FILE=
WSO_TVT_BRIDGE_CLIENT_CERT_FILE=
WSO_TVT_BRIDGE_CLIENT_KEY_FILE=
# Separate worker only: install wso-tvt-bridge[worker], run python -m wso_tvt_bridge.
WSO_TVT_BRIDGE_BIND=
WSO_TVT_BRIDGE_SERVER_CERT_FILE=
WSO_TVT_BRIDGE_SERVER_KEY_FILE=
WSO_TVT_BRIDGE_CLIENT_SANS_JSON=
WSO_TVT_ACCOUNT_PROFILE_FILE=
# Generate the trusted profile with scripts/dev/write_tvt_account_profile.py.
# Worker alone receives WSO_WORKER_DATABASE_URL and the saved-token key file.
# See docs/integrations/tvt-account-runtime.md; validated JSON is not upstream acceptance.
